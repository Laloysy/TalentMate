.env
.env.local
.env.*.local

# 操作系统生成文件
.DS_Store
Thumbs.db
voice-calendar.tar.gz

# IDE 和编辑器配置
.vscode/
.idea/
*.swp
*.swo
*~
images

# 日志文件
*.log
npm-debug.log*
pnpm-debug.log*

# 上传的音频临时文件（后端 multer 可能写入的目录）
server/uploads/
server/tmp/
temp/

